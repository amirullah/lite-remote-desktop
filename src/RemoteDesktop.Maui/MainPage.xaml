<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RemoteDesktop.Maui.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F2F6FD, Dark=#0A1220}">
    <ContentPage.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#5B6B86, Dark=#8FA3C4}"/>
            <Setter Property="Margin" Value="2,6,0,2"/>
        </Style>
        <Style x:Key="Field" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#D5DFEF, Dark=#22335A}"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EEF3FB, Dark=#0D1628}"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="Seg" TargetType="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#5B6B86, Dark=#8FA3C4}"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="22,40,22,24" Spacing="6" MaximumWidthRequest="520">
            <!-- update banner (shown when GitHub has a newer APK) -->
            <Border x:Name="UpdateBanner" IsVisible="False" StrokeShape="RoundRectangle 14" StrokeThickness="0"
                    BackgroundColor="#2F7CF6" Padding="14,10" Margin="0,0,0,14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label x:Name="UpdateText" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                    <Button x:Name="UpdateBtn" Grid.Column="1" Text="Perbarui" BackgroundColor="White" TextColor="#2F7CF6"
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="38" Padding="14,0" Clicked="Update_Clicked"/>
                </Grid>
            </Border>

            <!-- brand -->
            <HorizontalStackLayout Spacing="14" Margin="2,0,0,18">
                <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#2F7CF6">
                    <Label Text="◆" FontSize="22" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="LiteRemote" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0E1B33, Dark=White}"/>
                    <Label Text="Remote desktop cepat · ringan · aman" FontSize="13" TextColor="{AppThemeBinding Light=#5B6B86, Dark=#8FA3C4}"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- saved sessions -->
            <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,6">
                <Label Text="Sesi tersimpan" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#0E1B33, Dark=White}"/>
                <Button Grid.Column="1" Text="+ Sesi baru" Clicked="NewSession_Clicked"
                        BackgroundColor="#2F7CF6" TextColor="White" FontAttributes="Bold" FontSize="14"
                        CornerRadius="12" HeightRequest="42" Padding="16,0"/>
            </Grid>
            <Label x:Name="StatusLabel" IsVisible="False" TextColor="#E5484D" FontSize="13" Margin="4,0"/>

            <Border x:Name="EmptyState" IsVisible="False" StrokeShape="RoundRectangle 18" Padding="20" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#D5DFEF, Dark=#22335A}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111C30}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Belum ada sesi tersimpan" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#0E1B33, Dark=White}"/>
                    <Label HorizontalTextAlignment="Center" FontSize="13" TextColor="{AppThemeBinding Light=#5B6B86, Dark=#8FA3C4}"
                           Text="Ketuk &quot;+ Sesi baru&quot;, isi alamat IP atau ID host beserta password-nya, lalu simpan. Setelah itu cukup ketuk kartunya untuk tersambung."/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="SessionList" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 16" Padding="14,12" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#D5DFEF, Dark=#22335A}"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#111C30}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Session_Tapped"/>
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light=#E3EDFE, Dark=#16284A}" VerticalOptions="Center">
                                    <Label Text="{Binding Badge}" FontSize="13" FontAttributes="Bold" TextColor="#2F7CF6"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light=#0E1B33, Dark=White}"/>
                                    <Label Text="{Binding Subtitle}" FontSize="12" LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light=#5B6B86, Dark=#8FA3C4}"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="0" IsVisible="{Binding HasVpn}" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,-8"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 6" BackgroundColor="#2F7CF6" Padding="6,1">
                                    <Label Text="VPN" FontSize="10" FontAttributes="Bold" TextColor="White"/>
                                </Border>
                                <Button Grid.Column="2" Text="✎" FontSize="18" WidthRequest="40" HeightRequest="40" Padding="0"
                                        BackgroundColor="Transparent" TextColor="#2F7CF6" Clicked="Edit_Clicked"
                                        SemanticProperties.Description="Ubah sesi"/>
                                <Button Grid.Column="3" Text="🗑" FontSize="16" WidthRequest="40" HeightRequest="40" Padding="0"
                                        BackgroundColor="Transparent" TextColor="#E5484D" Clicked="Delete_Clicked"
                                        SemanticProperties.Description="Hapus sesi"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Margin="4,10,4,0" FontSize="12" TextColor="{AppThemeBinding Light=#5B6B86, Dark=#8FA3C4}"
                   Text="Ketuk kartu untuk menyambung · ✎ ubah · 🗑 hapus."/>
            <Label Margin="4,14,4,0" FontSize="12" TextColor="{AppThemeBinding Light=#5B6B86, Dark=#8FA3C4}"
                   Text="Tips: di sesi, ketuk = klik · tahan = klik kanan · cubit = zoom · geser dua jari = scroll · tombol ⌨ untuk keyboard."/>
            <Label x:Name="VersionLabel" Margin="4,10,4,0" FontSize="11" HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light=#8A99B3, Dark=#5B6B86}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Version_Tapped"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Text="Lisensi" Margin="4,4,4,0" FontSize="12" HorizontalOptions="Center" TextColor="#2F7CF6"
                   TextDecorations="Underline">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="License_Tapped"/>
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
